# --- Required ---
DATABASE_URL="postgresql://rasd:rasd@localhost:5432/rasd"
# Public URL used in alert emails
APP_URL="http://localhost:3000"
# Default UI language for new visitors: "ar" or "en"
DEFAULT_LOCALE="ar"

# --- Social data (Monid) ---
# Required for LIVE workspaces. Seeded DEMO workspaces stay demo regardless of this key.
MONID_API_KEY=""
# Optional: swap the scraper used for a platform + monitor type, format "provider#endpoint"
# MONID_ENDPOINT_X_KEYWORD="apify#apidojo/tweet-scraper"

# --- AI (Claude) ---
# Enables sentiment/topic classification, the assistant, briefs and reports.
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"            # assistant + reports
# AI_ENRICH_MODEL="claude-opus-5-5"     # per-post classification (high volume; claude-haiku-5-5 is ~40x cheaper)

# --- Email alerts (optional) ---
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# EMAIL_FROM="Rasd <alerts@example.com>"

# --- Chat alerts (optional) ---
# Slack and Microsoft Teams webhook hosts are allowed by default; add others here.
# WEBHOOK_ALLOWED_HOSTS="chat.example.com"

# Display timezone fallback (each organization also has its own; default Asia/Riyadh)
# NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Riyadh"

# --- Seed (optional) ---
# SEED_EMAIL="admin@example.com"
# SEED_PASSWORD="change-me-please"
