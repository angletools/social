{
  "name": "rasd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c blue,magenta \"next dev\" \"npm run worker\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "monid:discover": "tsx --env-file-if-exists=.env scripts/monid-discover.ts",
    "eval:dialect": "tsx --env-file-if-exists=.env scripts/eval-dialect.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/urbanist": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "next": "15.5.29",
    "nodemailer": "^10.5.0",
    "pg-boss": "^10.4.2",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.37.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
